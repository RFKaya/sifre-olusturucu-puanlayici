# PASSWORD ANALYZER CONFIGURATION
# Copy this file to .env and customize your policies.

# Offline Mode: Set to true to disable HIBP API lookup (for air-gapped systems)
OFFLINE_MODE=false

# Global Policy Rules
MIN_PASSWORD_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARACTERS=true

# Custom Blacklisted Dictionary Words (comma-separated, case-insensitive)
CUSTOM_BLACKLIST_WORDS=istinye,bgt006,cyber,security,keyvan,arasteh

# HIBP API Configuration
HIBP_API_URL=https://api.pwnedpasswords.com/range/
REQUEST_TIMEOUT_SECONDS=5
